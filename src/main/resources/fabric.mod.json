{
  "schemaVersion": 1,
  "id": "playerlog",
  "version": "${version}",
  "name": "PlayerLog",
  "description": "Server-side player event monitoring and notifications.",
  "authors": ["Mintype"],
  "contact": {},
  "license": "MIT",
  "environment": "*",
  "entrypoints": {
    "fabric-datagen": [
      "org.mintype.playerlog.client.PlayerlogDataGenerator"
    ],
    "client": [
      "org.mintype.playerlog.client.PlayerlogClient"
    ],
    "main": [
      "org.mintype.playerlog.Playerlog"
    ]
  },
  "mixins": [
    "playerlog.mixins.json",
    {
      "config": "playerlog.client.mixins.json",
      "environment": "client"
    }
  ],
  "depends": {
    "fabricloader": ">=${loader_version}",
    "fabric-api": "*",
    "minecraft": "${minecraft_version}"
  }
}
